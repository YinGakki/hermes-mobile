*.iml
.gradle/
local.properties
.idea/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/

# Bootstrap archive (downloaded at build time, ~30MB)
app/src/main/assets/bootstrap-*.zip

# Wheel cache (generated by CI from `pip download`, ~30MB packed).
# Two storage forms supported by setupWheelCacheIfPresent():
#   - wheels.tar.gz  (preferred: single compressed file)
#   - wheels/         (directory of individual .whl files)
app/src/main/assets/wheels.tar.gz
app/src/main/assets/wheels/

# Python deb bundle (generated by CI from scripts/fetch-python-bundle.py,
# ~30-50MB packed). Extracted by installPython() on first launch.
app/src/main/assets/python-bundle.tar.gz
app/src/main/assets/python-bundle/

# Server bundle (built from parent project)
app/src/main/assets/server-bundle/

# Gradle wrapper jar must be committed — required for ./gradlew to run on CI.
/.kotlin/
