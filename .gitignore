*.iml
.gradle/
local.properties
.idea/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/

# Bootstrap archive (downloaded at build time, ~30MB)
# Lives in main/assets so BOTH flavors get it.
app/src/main/assets/bootstrap-*.zip

# Wheel cache (generated by CI from `pip download`, ~50MB packed).
# Lives in full/assets so ONLY the full flavor gets it.
# Two storage forms supported by setupWheelCacheIfPresent():
#   - wheels.tar.gz  (preferred: single compressed file)
#   - wheels/         (directory of individual .whl files)
app/src/full/assets/wheels.tar.gz
app/src/full/assets/wheels/

# Deb bundle (generated by CI from scripts/fetch-python-bundle.py,
# ~162MB packed). Contains Python + proot + node + build deps + all
# transitive native deps. Extracted once at setup start by
# extractDebBundleIfPresent() into $prefix/tmp/.
# Lives in full/assets so ONLY the full flavor gets it.
app/src/full/assets/deb-bundle.tar.gz
app/src/full/assets/deb-bundle/

# Server bundle (built from parent project)
app/src/main/assets/server-bundle/

# Gradle wrapper jar must be committed — required for ./gradlew to run on CI.
/.kotlin/
