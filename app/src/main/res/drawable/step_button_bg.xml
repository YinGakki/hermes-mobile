<?xml version="1.0" encoding="utf-8"?>
<!-- Step button background: rounded card with emerald tint to distinguish
     primary install actions from the plain dark dashboard cards. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22ffffff">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#1e293b" />
        </shape>
    </item>
</ripple>
